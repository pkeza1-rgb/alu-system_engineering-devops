#!/usr/bin/env bash
# Installs and configures HAProxy on a new Ubuntu machine to
# load balance web-01 and web-02 using roundrobin.

set -e

apt-get update -y
apt-get install -y haproxy

# Make sure HAProxy can be managed via its init script
if [ -f /etc/default/haproxy ]; then
    if grep -q '^ENABLED=' /etc/default/haproxy; then
        sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
    else
        echo 'ENABLED=1' >> /etc/default/haproxy
    fi
fi

# Append load balancer config (only once)
if ! grep -q 'backend web_servers' /etc/haproxy/haproxy.cfg; then
    cat >> /etc/haproxy/haproxy.cfg <<'EOF'

frontend http_front
    bind *:80
    mode http
    default_backend web_servers

backend web_servers
    mode http
    balance roundrobin
    server 7326-web-01 3.8.175.197:80 check
    server 7326-web-02 3.8.101.123:80 check
EOF
fi

# Validate config, then enable and restart via init script
haproxy -c -f /etc/haproxy/haproxy.cfg
service haproxy enable 2>/dev/null || true
service haproxy restart
