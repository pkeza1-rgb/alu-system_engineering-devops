#!/usr/bin/env bash
# Installs and configures HAProxy to round-robin traffic between web-01 and web-02

sudo apt-get update -y
sudo apt-get install -y haproxy

# Allow HAProxy to be managed through its init script
sudo sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
grep -q '^ENABLED=' /etc/default/haproxy || echo 'ENABLED=1' | sudo tee -a /etc/default/haproxy > /dev/null

sudo tee /etc/haproxy/haproxy.cfg > /dev/null <<'EOF'
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend http-in
    bind *:80
    default_backend web-backend

backend web-backend
    balance roundrobin
    server 7326-web-01 3.8.175.197:80 check
    server 7326-web-02 3.8.101.123:80 check
EOF

sudo haproxy -c -f /etc/haproxy/haproxy.cfg
sudo service haproxy restart
