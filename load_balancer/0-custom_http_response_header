#!/usr/bin/env bash
# Installs Nginx and adds a custom X-Served-By response header set to the server hostname
# shellcheck disable=SC2154

sudo apt-get update -y
sudo apt-get install -y nginx

echo "Hello World!" | sudo tee /var/www/html/index.html > /dev/null

# Remove any previous header line so the script can be re-run safely
sudo sed -i '/add_header X-Served-By/d' /etc/nginx/sites-available/default

# Add the header (value = hostname of this server) right after server_name
sudo sed -i "s|server_name _;|server_name _;\n\tadd_header X-Served-By $(hostname);|" /etc/nginx/sites-available/default

sudo nginx -t
sudo service nginx restart
