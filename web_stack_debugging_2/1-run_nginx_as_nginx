#!/usr/bin/env bash
# Configures Nginx to run as the nginx user and listen on all IPs on port 8080

# Set the user directive to nginx (handles commented or existing user lines)
sed -i 's/^\s*#\?\s*user\s\+[^;]*;/user nginx;/' /etc/nginx/nginx.conf

# Listen on port 8080 (IPv4 and IPv6) instead of 80
sed -i 's/\b80\b/8080/g' /etc/nginx/sites-available/default

# Make sure the nginx user can read the config
chmod 644 /etc/nginx/nginx.conf

# Stop anything that could hold the port (Apache) and any running Nginx
pkill apache2
service nginx stop
pkill -9 nginx

# Start Nginx as the nginx user
sudo -u nginx service nginx start
 
